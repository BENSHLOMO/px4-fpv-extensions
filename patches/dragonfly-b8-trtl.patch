+            default: 300
+            unit: "ms"
+        TRTL_DB:
+            description:
+                short: "Recovery roll/pitch deadband"
+                long: |
+                    Percent of normalized roll or pitch. Diagonal deflection selects a single corner; axis-only input selects a pair.
+            type: int32
