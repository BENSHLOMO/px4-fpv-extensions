+            default: 800
+            unit: "ms"
+        TRTL_POST:
+            description:
+                short: "Stop time before restore commands"
+                long: |
+                    Time spent transmitting stop before normal-direction restore. Increase for slower-stopping propulsion. A fixed delay does not prove the motor stopped.
+            type: int32
+            min: 200
+            max: 5000
+            default: 1000
+            unit: "ms"
+        TRTL_SETTLE:
+            description:
+                short: "Stop time after reversal commands"
+                long: |
+                    Stopped interval after a reverse command train, before drive.
+            type: int32
+            min: 100
