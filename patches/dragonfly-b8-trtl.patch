+// Legacy Stage 2B1 recovery diagnostics retained for historical context.
+// The active Stage 2B8 controller is motor-capable and owns recovery output;
+// these older diagnostics are not the authority for the current logic.
+// Stage 2B5: read PX4 parameter values while IDLE, not during a motor burst.
+// Polling at 4 Hz avoids expensive parameter accesses in the 8+ kHz output loop.
+// 2B6: select a physical RC input channel, not a hard-coded AUX slot.
+float DShot::turtle_radio_value(int32_t channel) const
+{
+    const uint64_t now = hrt_absolute_time();
+    if (!dragonfly_turtle_rc::healthy(now, _turtle_rc_channels.timestamp,
+                                     _turtle_rc_channels.timestamp_last_valid,
+                                     _turtle_rc_channels.signal_lost)) {
+        return NAN;
+    }
+    return dragonfly_turtle_rc::select(_turtle_rc_channels.channels,
+                                      _turtle_rc_channels.channel_count, channel);
+}
+
+// 2B7: accepted only while idle, disarmed, with old and new switches OFF.
+// Values are frozen for the complete recovery, including direction restoration.
+void DShot::update_turtle_parameters()
+{
+    using namespace dragonfly_trtl;
+    const uint64_t now=hrt_absolute_time();
+    if (_trtl_last_params && now>=_trtl_last_params && now-_trtl_last_params<250000) { return; }
+    _trtl_last_params=now;
+    if (_trtl_enable_handle==PARAM_INVALID) {_trtl_enable_handle=param_find("TRTL_EN");}
+    int32_t requested=0;
+    if (_trtl_enable_handle!=PARAM_INVALID && param_get(_trtl_enable_handle,&requested)==PX4_OK) {_trtl_requested=requested!=0;}
+    if (_trtl_core.busy() || interlock().owner()==Owner::FLIGHT) {return;}
+    if (!fresh(now,_turtle_status.timestamp,750000) || !fresh(now,_turtle_armed.timestamp,750000)
+        || _turtle_status.arming_state!=vehicle_status_s::ARMING_STATE_DISARMED
+        || _turtle_armed.armed || _mixing_output.armed().armed) { return; }
+    if (_trtl_loaded && !_trtl_input.switch_off) { return; }
+    const char *names[]={"TRTL_EN","TRTL_ESC","TRTL_CH","TRTL_POL",
+        "TRTL_ANGLE","TRTL_EXIT","TRTL_MIN","TRTL_MAX","TRTL_RAMP","TRTL_TIME",
+        "TRTL_PRE","TRTL_POST","TRTL_SETTLE","TRTL_COOL","TRTL_DB","TRTL_PWR","TRTL_HOLD",
+        "TRTL_FL","TRTL_FR","TRTL_RL","TRTL_RR","CA_ROTOR_COUNT"};
+    const unsigned count=sizeof(names)/sizeof(names[0]);
+    if (!_trtl_handles_initialized) { for (auto &h:_trtl_handles) {h=PARAM_INVALID;} _trtl_handles_initialized=true; }
+    int32_t v[25]{};
+    for (unsigned i=0;i<count;++i) {
+        if (_trtl_handles[i]==PARAM_INVALID) {_trtl_handles[i]=param_find(names[i]);}
+        if (_trtl_handles[i]==PARAM_INVALID || param_get(_trtl_handles[i],&v[i])!=PX4_OK) {
+            _trtl_loaded=false;_trtl_core.invalidate();return;
+        }
+    }
+    Config c;
+    c.enabled=v[0];c.esc=v[1];c.channel=v[2];c.polarity=v[3];c.entry_deg=v[4];c.exit_deg=v[5];
+    c.start=v[6];c.peak=v[7];c.ramp_ms=v[8];c.drive_ms=v[9];c.pre_ms=v[10];c.post_ms=v[11];
+    c.settle_ms=v[12];c.cooldown_ms=v[13];c.deadband_pct=v[14];c.proportional=v[15];c.hold_ms=v[16];
+    dragonfly_mapping::Config corners;
+    for (unsigned i=0;i<4;++i) {corners.motor[i]=v[17+i];}
+    int32_t functions[MAX_ACTUATORS]{};
+    static_assert(MAX_ACTUATORS<=32,"Turtle output mask too narrow");
+    for (unsigned i=0;i<MAX_ACTUATORS;++i) {functions[i]=static_cast<int32_t>(_mixing_output.outputFunction(i));}
+    const auto resolved=dragonfly_mapping::resolve(corners,functions,MAX_ACTUATORS,_output_mask);
+    c.outputs=resolved.all;
+    _trtl_geometry_ok=v[21]==4 && resolved.valid();
+    // Validate configured allocation positions and axes, not just the number of motors.
+    const char *suffix[]={"PX","PY","AX","AY","AZ"};
+    for (unsigned i=0;i<4 && _trtl_geometry_ok;++i) {
+        float geom[5]{};
+        for (unsigned j=0;j<5;++j) {
+            char name[24];snprintf(name,sizeof(name),"CA_ROTOR%ld_%s",long(corners.motor[i]-1),suffix[j]);
+            const param_t p=param_find(name);
+            if (p==PARAM_INVALID || param_get(p,&geom[j])!=PX4_OK) {_trtl_geometry_ok=false;break;}
+        }
+        _trtl_geometry_ok=_trtl_geometry_ok && quad_corner(i,geom[0],geom[1],geom[2],geom[3],geom[4]);
+        char tilt_name[32];snprintf(tilt_name,sizeof(tilt_name),"CA_ROTOR%ld_TILT",long(corners.motor[i]-1));
+        const param_t tilt_handle=param_find(tilt_name);int32_t tilt=0;
+        if (tilt_handle==PARAM_INVALID || param_get(tilt_handle,&tilt)!=PX4_OK || tilt!=0) {_trtl_geometry_ok=false;}
+    }
+    _trtl_rc_conflict=rc_conflict(_turtle_rc_channels.function,
+        sizeof(_turtle_rc_channels.function)/sizeof(_turtle_rc_channels.function[0]),c.channel);
+    // Mode selection can be separate from rc_channels.function in this PX4 generation.
+    const char *mode_names[]={"RC_MAP_FLTMODE","RC_MAP_MODE_SW","RC_MAP_FLTBTN"};
+    for (const auto name:mode_names) {
+        const param_t p=param_find(name);int32_t ch=0;
+        if (p!=PARAM_INVALID && param_get(p,&ch)==PX4_OK && ch==c.channel) {_trtl_rc_conflict=true;}
+    }
+    const bool raw_ok=dragonfly_turtle_rc::healthy(now,_turtle_rc_channels.timestamp,
+        _turtle_rc_channels.timestamp_last_valid,_turtle_rc_channels.signal_lost);
+    const float raw=raw_ok?dragonfly_turtle_rc::select(_turtle_rc_channels.channels,
+        _turtle_rc_channels.channel_count,c.channel):NAN;
+    if (!std::isfinite(raw) || raw*float(c.polarity)>=-0.3f) {return;}
+    _trtl_loaded=false;
+    if (!resolved.valid() || !_trtl_geometry_ok || _trtl_rc_conflict || !c.valid()) {_trtl_core.invalidate();return;}
+    // Changes to mapping invalidate synchronization even if the same four output bits are reused.
+    if (_trtl_core.configured() && !dragonfly_mapping::same(_trtl_map,resolved)) {_trtl_core.invalidate();}
+    _trtl_config=c;_trtl_map_config=corners;_trtl_map=resolved;
+    _trtl_loaded=_trtl_core.configure(c);
+}
