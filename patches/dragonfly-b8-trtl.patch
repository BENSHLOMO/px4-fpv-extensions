+            type: int32
+            min: 100
+            max: 3000
+            default: 1000
+            unit: "ms"
+        TRTL_PRE:
+            description:
+                short: "Stop time before reverse commands"
+                long: |
+                    Time spent transmitting stop before temporary reversal. Choose from measured coast-down on the actual motor and propeller; this is not RPM confirmation.
+            type: int32
+            min: 100
