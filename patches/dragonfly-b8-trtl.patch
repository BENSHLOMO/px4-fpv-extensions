+void DShot::update_turtle_inputs()
+{
+    using namespace dragonfly_trtl;
+    if (_turtle_manual_sub.updated()) {_turtle_manual_sub.copy(&_turtle_manual);}
+    if (_turtle_status_sub.updated()) {_turtle_status_sub.copy(&_turtle_status);}
+    if (_turtle_armed_sub.updated()) {_turtle_armed_sub.copy(&_turtle_armed);}
+    if (_turtle_att_sub.updated()) {_turtle_att_sub.copy(&_turtle_att);}
+    if (_turtle_rc_sub.updated()) {_turtle_rc_sub.copy(&_turtle_rc_channels);}
+    const uint64_t now=hrt_absolute_time();
+    Input in;
+    const bool state_fresh=fresh(now,_turtle_status.timestamp,750000) && fresh(now,_turtle_armed.timestamp,750000);
+    in.disarmed=state_fresh && _turtle_status.arming_state==vehicle_status_s::ARMING_STATE_DISARMED
+        && !_turtle_armed.armed && !_mixing_output.armed().armed;
+    const auto &a=_mixing_output.armed();
+    in.hardware_ok=state_fresh && !_turtle_armed.lockdown && !_turtle_armed.manual_lockdown
+        && !_turtle_armed.force_failsafe && !_turtle_armed.in_esc_calibration_mode
+        && !a.lockdown && !a.manual_lockdown && !a.force_failsafe && !a.in_esc_calibration_mode
+        && (!_turtle_status.safety_button_available || _turtle_status.safety_off)
+        && !_turtle_status.calibration_enabled && !_turtle_status.rc_calibration_in_progress
+        && !_turtle_status.failsafe && !_mixing_output.isActuatorTestRunning() && !_current_command.valid();
+    int32_t functions[MAX_ACTUATORS]{};
+    for (unsigned i=0;i<MAX_ACTUATORS;++i) {functions[i]=static_cast<int32_t>(_mixing_output.outputFunction(i));}
+    const auto current=dragonfly_mapping::resolve(_trtl_map_config,functions,MAX_ACTUATORS,_output_mask);
+    _trtl_map_ok=_trtl_loaded && _trtl_geometry_ok && dragonfly_mapping::same(current,_trtl_map)
+        && !_turtle_status.is_vtol && _turtle_status.vehicle_type==vehicle_status_s::VEHICLE_TYPE_ROTARY_WING
+        && !_param_dshot_3d_enable.get() && !_reversible_outputs;
+    in.mapping_ok=_trtl_map_ok;
+    const bool raw_ok=dragonfly_turtle_rc::healthy(now,_turtle_rc_channels.timestamp,
+        _turtle_rc_channels.timestamp_last_valid,_turtle_rc_channels.signal_lost);
+    const bool conflict=rc_conflict(_turtle_rc_channels.function,
+        sizeof(_turtle_rc_channels.function)/sizeof(_turtle_rc_channels.function[0]),_trtl_config.channel);
+    in.rc_ok=raw_ok && !conflict && !_trtl_rc_conflict && fresh(now,_turtle_manual.timestamp,300000)
+        && fresh(now,_turtle_manual.timestamp_sample,300000) && _turtle_manual.valid
+        && _turtle_manual.data_source==manual_control_setpoint_s::SOURCE_RC;
+    const float raw=raw_ok?dragonfly_turtle_rc::select(_turtle_rc_channels.channels,
+        _turtle_rc_channels.channel_count,_trtl_config.channel):NAN;
+    const float sw=raw*float(_trtl_config.polarity);
+    in.switch_on=in.rc_ok && std::isfinite(sw) && sw>0.7f;
+    // Center position is neither a valid reset nor ON. Ambiguous switch values stop a burst.
+    in.switch_off=in.rc_ok && std::isfinite(sw) && sw< -0.3f;
+    in.throttle_low=in.rc_ok && std::isfinite(_turtle_manual.throttle) && _turtle_manual.throttle< -0.85f;
+    in.vertical=vertical(_turtle_att.q);
+    in.attitude_ok=fresh(now,_turtle_att.timestamp,300000) && std::isfinite(in.vertical);
+    const float roll=_turtle_manual.roll,pitch=_turtle_manual.pitch;
+    const bool sticks=std::isfinite(roll)&&std::isfinite(pitch)&&std::fabs(roll)<=1.05f&&std::fabs(pitch)<=1.05f;
+    if(sticks) {
+        in.selected=dragonfly_mapping::select(_trtl_map,roll,pitch,float(_trtl_config.deadband_pct)*0.01f);
+        const float roll_magnitude = std::fabs(roll);
+        const float pitch_magnitude = std::fabs(pitch);
+        in.strength = (roll_magnitude > pitch_magnitude) ? roll_magnitude : pitch_magnitude;
+        if(in.strength>1.f) {in.strength=1.f;}
+    } else {in.rc_ok=false;}
+    _trtl_input=in;
+}
