diff --git a/src/drivers/dshot/DragonflyTurtleAngle.hpp b/src/drivers/dshot/DragonflyTurtleAngle.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..0af31ba302935979cf552bdf35a8d5414cc0fdcd
--- /dev/null
+++ b/src/drivers/dshot/DragonflyTurtleAngle.hpp
@@ -0,0 +1,21 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Angle relative to upright for PX4 turtle recovery.
+#pragma once
+#include <cmath>
+#include <cstdint>
+#include <math.h> // NAN: no C++ limits dependency
+namespace dragonfly_turtle_angle {
+constexpr int32_t min_deg=85, max_deg=175, default_deg=120;
+constexpr float to_radians=0.01745329251994329577f;
+inline bool valid(int32_t d) { return d>=min_deg && d<=max_deg; }
+inline float threshold(int32_t d) { return valid(d) ? std::cos(d*to_radians) : NAN; }
+inline bool inverted(const float* q, float limit) {
+    if (!q || !std::isfinite(limit)) return false;
+    const float w=q[0], x=q[1], y=q[2], z=q[3];
+    if (!std::isfinite(w)||!std::isfinite(x)||!std::isfinite(y)||!std::isfinite(z)) return false;
+    const float norm=w*w+x*x+y*y+z*z;
+    if (!std::isfinite(norm) || norm<0.9f || norm>1.1f) return false;
+    const float proj=1.f-2.f*(x*x+y*y)/norm;
+    return std::isfinite(proj) && proj <= limit;
+}
+} // namespace dragonfly_turtle_angle
diff --git a/src/drivers/dshot/DragonflyTurtleCore.hpp b/src/drivers/dshot/DragonflyTurtleCore.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..f25cc92a9726706c0355fb5cf779eee3da13beb6
--- /dev/null
+++ b/src/drivers/dshot/DragonflyTurtleCore.hpp
@@ -0,0 +1,226 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// 2B8: hardware-independent Quad-X recovery controller. No actuator calls.
+#pragma once
+#include <cmath>
+#include <cstdint>
+#include "ArmingInterlock.hpp"
+namespace dragonfly_trtl {
+enum class Phase : uint8_t { IDLE, HOLD, PRESTOP, REVERSE, SETTLE, DRIVE, POSTSTOP, RESTORE, COOLDOWN, WAIT_OFF, FAULT };
+enum class Action : uint8_t { NORMAL, STOP, REVERSE, RESTORE, THROTTLE };
+enum class Reason : uint8_t { NONE, SWITCH, RC, THROTTLE, UPRIGHT, SAFETY, ARMED, MAPPING, TIMEOUT, CALLBACK_GAP, CLOCK, COMMAND_TIMEOUT };
+inline const char *phase_name(Phase p) {
+    switch(p) {
+    case Phase::IDLE:return "IDLE";case Phase::HOLD:return "HOLD";case Phase::PRESTOP:return "PRESTOP";
+    case Phase::REVERSE:return "REVERSE";case Phase::SETTLE:return "SETTLE";case Phase::DRIVE:return "DRIVE";
+    case Phase::POSTSTOP:return "POSTSTOP";case Phase::RESTORE:return "RESTORE";case Phase::COOLDOWN:return "COOLDOWN";
+    case Phase::WAIT_OFF:return "WAIT_OFF";case Phase::FAULT:return "FAULT";
+    } return "UNKNOWN";
+}
+inline const char *reason_name(Reason r) {
+    switch(r) {
+    case Reason::NONE:return "NONE";case Reason::SWITCH:return "SWITCH";case Reason::RC:return "RC";
+    case Reason::THROTTLE:return "THROTTLE";case Reason::UPRIGHT:return "UPRIGHT";case Reason::SAFETY:return "SAFETY";
+    case Reason::ARMED:return "ARMED";case Reason::MAPPING:return "MAPPING";case Reason::TIMEOUT:return "TIMEOUT";
+    case Reason::CALLBACK_GAP:return "CALLBACK_GAP";case Reason::CLOCK:return "CLOCK";
+    case Reason::COMMAND_TIMEOUT:return "COMMAND_TIMEOUT";
+    } return "UNKNOWN";
+}
+struct Config {
+    int32_t enabled{0}, esc{0}; // ESC=1: explicit user confirmation of compatible temporary 20/21 behavior.
+    int32_t channel{9}, polarity{1};
+    int32_t entry_deg{120}, exit_deg{35};
+    int32_t start{850}, peak{1500}, ramp_ms{250}, drive_ms{1000};
+    int32_t pre_ms{800}, post_ms{1000}, settle_ms{200}, cooldown_ms{300};
+    int32_t deadband_pct{20}, proportional{1}, hold_ms{400};
+    uint32_t outputs{0};
+    bool valid() const {
+        unsigned bits=0; for(uint32_t n=outputs;n;n&=n-1) {++bits;}
+        return (enabled==0||enabled==1) && (esc==0||esc==1) && channel>=1 && channel<=18
+            && (polarity==1||polarity==-1) && entry_deg>=60 && entry_deg<=175
+            && exit_deg>=5 && exit_deg<=80 && exit_deg+10<=entry_deg
+            && start>=1 && start<=1999 && peak>=start && peak<=1999
+            && ramp_ms>=0 && ramp_ms<=1500 && drive_ms>=100 && drive_ms<=3000 && ramp_ms<=drive_ms
+            && pre_ms>=100 && pre_ms<=5000 && post_ms>=200 && post_ms<=5000
+            && settle_ms>=100 && settle_ms<=1000 && cooldown_ms>=100 && cooldown_ms<=2000
+            && deadband_pct>=5 && deadband_pct<=60 && (proportional==0||proportional==1)
+            && hold_ms>=100 && hold_ms<=1000 && bits==4;
+    }
+    bool same(const Config &b) const {
+        return enabled==b.enabled && esc==b.esc && channel==b.channel && polarity==b.polarity
+            && entry_deg==b.entry_deg && exit_deg==b.exit_deg && start==b.start && peak==b.peak
+            && ramp_ms==b.ramp_ms && drive_ms==b.drive_ms && pre_ms==b.pre_ms && post_ms==b.post_ms
+            && settle_ms==b.settle_ms && cooldown_ms==b.cooldown_ms && deadband_pct==b.deadband_pct
+            && proportional==b.proportional && hold_ms==b.hold_ms && outputs==b.outputs;
+    }
+};
+struct Input {
+    bool disarmed{false}, hardware_ok{false}, mapping_ok{false}, rc_ok{false}, throttle_low{false};
+    bool switch_on{false}, switch_off{false}, attitude_ok{false};
+    float vertical{1.f}; // normalized body Z dot earth down; 1 upright, 0 side-on, -1 inverted.
+    uint32_t selected{0};
+    float strength{0.f}; // max absolute roll/pitch, validated to [0,1].
+};
+struct Frame { Action action{Action::NORMAL}; uint32_t outputs{0}; uint16_t level{0}; };
+class Core {
+public:
+    explicit Core(Interlock &lock):_lock(lock) {}
+    Phase phase{Phase::IDLE}; Reason reason{Reason::NONE};
+    uint32_t attempts{0}, restore_sequences_sent{0};
+    uint32_t reverse_frames{0}, restore_frames{0}, throttle_frames{0};
+    uint32_t last_drive_ms{0};
+    bool configured() const { return _configured; }
+    bool busy() const { return phase!=Phase::IDLE; }
+    bool owns_outputs() const { return _owned; }
+    bool synced() const { return _synced; }
+    bool enabled() const { return _configured && _cfg.enabled==1 && _cfg.esc==1; }
+    const Config &config() const { return _cfg; }
+    bool configure(const Config &cfg) {
+        if(busy() || !cfg.valid()) { return false; }
+        if(_configured && _cfg.same(cfg)) { return true; }
+        const bool resync = !_configured || _cfg.outputs!=cfg.outputs || _cfg.esc!=cfg.esc
+            || _cfg.enabled!=cfg.enabled;
+        _cfg=cfg; _configured=true; _off_since=0; _off_qualified=false;
+        if(resync) {_synced=false; _lock.set_ready(false);}
+        _entry_cos=std::cos(float(cfg.entry_deg)*0.017453292519943295f);
+        _exit_cos=std::cos(float(cfg.exit_deg)*0.017453292519943295f);
+        return true;
+    }
+    void invalidate() { if(!busy()) { _configured=false; _synced=false; _off_qualified=false; _lock.set_ready(false); } }
+    void fault(Reason why) { reason=why; phase=Phase::FAULT; _lock.latch_fault(); _owned=true; }
+    Frame step(uint64_t now,const Input &in) {
+        if(phase==Phase::FAULT) {return stop();}
+        if(!_configured || !enabled()) {return {};}
+        const uint64_t dt=_last?now-_last:0;
+        if(_last && now<_last) { if(_owned) {fault(Reason::CLOCK);return stop();} _off_qualified=false;_off_since=0; }
+        else if(_last && dt>100000 && drive_side()) { abort(now,Reason::CALLBACK_GAP); }
+        _last=now;
+        if(_owned && !in.mapping_ok) {fault(Reason::MAPPING);return stop();}
+        if(_owned && !in.disarmed) { abort(now,Reason::ARMED); }
+        // Startup normalization: wait, send temporary NORMAL, then require switch OFF.
+        // No assertion that the ESC accepted the commands is made.
+        if(phase==Phase::IDLE && !_synced) {
+            _lock.set_ready(false);
+            if(!in.mapping_ok || !in.disarmed || !in.hardware_ok || !_lock.acquire_recovery()) {return {};}
+            _owned=true;_startup=true;_since=now;_transaction_start=now;phase=Phase::POSTSTOP;
+        }
+        if(phase==Phase::IDLE) {
+            if(!in.disarmed || !in.hardware_ok || !in.mapping_ok || !in.rc_ok || !in.throttle_low) {
+                _off_since=0;_off_qualified=false;return {};
+            }
+            if(in.switch_off) {
+                if(!_off_since) {_off_since=now;}
+                if(now>=_off_since && now-_off_since>=release_us) {_off_qualified=true;}
+                return {};
+            }
+            if(!in.switch_on) {_off_since=0;return {};}
+            // Consume the OFF->ON request even if the start attitude is wrong.
+            // Leaving the switch ON and later disarming/tilting cannot launch recovery.
+            const bool edge=_off_qualified;_off_qualified=false;_off_since=0;
+            if(!edge || !in.attitude_ok || in.vertical>_entry_cos || !_lock.acquire_recovery()) {return {};}
+            _owned=true;_startup=false;phase=Phase::HOLD;_since=now;_transaction_start=now;reason=Reason::NONE;
+            _lock.set_ready(false);
+        }
+        if(drive_side()) {
+            Reason why=Reason::NONE;
+            if(!in.disarmed) {why=Reason::ARMED;}
+            else if(!in.hardware_ok || !in.mapping_ok) {why=Reason::SAFETY;}
+            else if(!in.rc_ok) {why=Reason::RC;}
+            else if(!in.switch_on) {why=Reason::SWITCH;}
+            else if(!in.throttle_low) {why=Reason::THROTTLE;}
+            else if(!in.attitude_ok) {why=Reason::SAFETY;}
+            else if((phase==Phase::HOLD && in.vertical>_entry_cos) || in.vertical>=_exit_cos) {why=Reason::UPRIGHT;}
+            if(why!=Reason::NONE) {abort(now,why);}
+        }
+        // Fail closed on an incomplete restoration or a stalled callback schedule.
+        // Budget is derived from settings, not a hidden two-second outer timer.
+        if(_owned && phase!=Phase::WAIT_OFF && now>=_transaction_start
+            && now-_transaction_start>transaction_budget_us()) {fault(Reason::COMMAND_TIMEOUT);return stop();}
+        switch(phase) {
+        case Phase::IDLE:return {};
+        case Phase::HOLD:
+            if(elapsed(now,ms(_cfg.hold_ms))) {phase=Phase::PRESTOP;_since=now;++attempts;}
+            return stop();
+        case Phase::PRESTOP:
+            if(!elapsed(now,ms(_cfg.pre_ms))) {return stop();}
+            begin_command(Phase::REVERSE,now);
+            return command(now,true);
+        case Phase::REVERSE:return command(now,true);
+        case Phase::SETTLE:
+            if(!elapsed(now,ms(_cfg.settle_ms))) {return stop();}
+            phase=Phase::DRIVE;_since=now;_drive_start=now;_selection_since=now;_selected=0;
+            return drive(now,in);
+        case Phase::DRIVE:return drive(now,in);
+        case Phase::POSTSTOP:
+            // Reset dwell whenever a stop/calibration/test condition prevents restoration.
+            if(!in.disarmed || !in.hardware_ok) {_since=now;return stop();}
+            if(!elapsed(now,ms(_cfg.post_ms))) {return stop();}
+            begin_command(Phase::RESTORE,now);
+            return command(now,false);
+        case Phase::RESTORE:
+            if(!in.disarmed || !in.hardware_ok) {phase=Phase::POSTSTOP;_since=now;return stop();}
+            return command(now,false);
+        case Phase::COOLDOWN:
+            if(!in.disarmed || !in.hardware_ok) {phase=Phase::POSTSTOP;_since=now;return stop();}
+            if(elapsed(now,ms(_cfg.cooldown_ms))) {phase=Phase::WAIT_OFF;_off_since=0;}
+            return stop();
+        case Phase::WAIT_OFF:
+            if(!in.disarmed || !in.hardware_ok || !in.mapping_ok || !in.rc_ok || !in.throttle_low || !in.switch_off) {
+                _off_since=0;return stop();
+            }
+            if(!_off_since) {_off_since=now;return stop();}
+            if(now>=_off_since && now-_off_since>=release_us) {
+                _synced=true;_owned=false;_startup=false;phase=Phase::IDLE;_off_qualified=true;
+                _lock.set_ready(true);_lock.release_recovery();return {};
+            }
+            return stop();
+        case Phase::FAULT:return stop();
+        }
+        return stop();
+    }
+private:
+    static constexpr uint64_t release_us=300000, command_dwell_us=50000, command_timeout_us=2000000;
+    static constexpr uint32_t command_min_frames=24;
+    Interlock &_lock; Config _cfg{};
+    bool _configured{false},_synced{false},_owned{false},_startup{false},_off_qualified{false};
+    uint64_t _last{0},_since{0},_transaction_start{0},_off_since{0},_drive_start{0},_selection_since{0};
+    uint32_t _count{0},_selected{0}; float _entry_cos{-0.5f},_exit_cos{0.81915f};
+    static uint64_t ms(int32_t v) {return uint64_t(v)*1000;}
+    bool elapsed(uint64_t now,uint64_t duration) const {return now>=_since && now-_since>=duration;}
+    static Frame stop() {return {Action::STOP,0,0};}
+    bool drive_side() const {return phase==Phase::HOLD || phase==Phase::PRESTOP || phase==Phase::REVERSE || phase==Phase::SETTLE || phase==Phase::DRIVE;}
+    void abort(uint64_t now,Reason why) {
+        if(!drive_side()) {return;}
+        if(phase==Phase::DRIVE) {last_drive_ms=uint32_t((now-_drive_start)/1000);}
+        reason=why;phase=Phase::POSTSTOP;_since=now;_selected=0;_count=0;
+    }
+    uint64_t transaction_budget_us() const {
+        return ms(_cfg.hold_ms+_cfg.pre_ms+_cfg.settle_ms+_cfg.drive_ms+_cfg.post_ms+_cfg.cooldown_ms)
+            +2*command_timeout_us+2000000;
+    }
+    void begin_command(Phase p,uint64_t now) {phase=p;_since=now;_count=0;}
+    Frame command(uint64_t now,bool reverse) {
+        if(elapsed(now,command_timeout_us)) {fault(Reason::COMMAND_TIMEOUT);return stop();}
+        ++_count;
+        if(reverse) {++reverse_frames;} else {++restore_frames;}
+        if(_count>=command_min_frames && elapsed(now,command_dwell_us)) {
+            phase=reverse?Phase::SETTLE:Phase::COOLDOWN;_since=now;
+            if(!reverse) {++restore_sequences_sent;}
+        }
+        return {reverse?Action::REVERSE:Action::RESTORE,_cfg.outputs,0};
+    }
+    Frame drive(uint64_t now,const Input &in) {
+        if(elapsed(now,ms(_cfg.drive_ms))) {last_drive_ms=uint32_t((now-_drive_start)/1000);abort(now,Reason::TIMEOUT);return stop();}
+        const uint32_t selected=in.selected&_cfg.outputs;
+        if(!selected || !std::isfinite(in.strength)) {_selected=0;_selection_since=now;return stop();}
+        if(selected!=_selected) {_selected=selected;_selection_since=now;}
+        const float db=float(_cfg.deadband_pct)*0.01f;
+        float fraction=(in.strength-db)/(1.f-db);
+        if(fraction<0.f) {fraction=0.f;} if(fraction>1.f) {fraction=1.f;}
+        const uint16_t target=_cfg.proportional?uint16_t(_cfg.start+float(_cfg.peak-_cfg.start)*fraction):uint16_t(_cfg.peak);
+        const uint64_t ramp=ms(_cfg.ramp_ms),since=now-_selection_since;
+        const uint16_t cap=(!ramp||since>=ramp)?uint16_t(_cfg.peak):uint16_t(_cfg.start+(uint64_t(_cfg.peak-_cfg.start)*since)/ramp);
+        ++throttle_frames;
+        return {Action::THROTTLE,selected,target<cap?target:cap};
+    }
+};
+} // namespace dragonfly_trtl
diff --git a/src/drivers/dshot/DragonflyTurtleInput.hpp b/src/drivers/dshot/DragonflyTurtleInput.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..64b1555fa495a839afe6bef28c08a82867717d7e
--- /dev/null
+++ b/src/drivers/dshot/DragonflyTurtleInput.hpp
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#pragma once
+#include <cmath>
+#include <cstdint>
+#include <cstddef>
+namespace dragonfly_trtl {
+inline bool fresh(uint64_t now,uint64_t stamp,uint64_t limit) {
+    return stamp && now>=stamp && now-stamp<limit;
+}
+inline float vertical(const float q[4]) {
+    const float n=q[0]*q[0]+q[1]*q[1]+q[2]*q[2]+q[3]*q[3];
+    if(!std::isfinite(n) || n<0.9f || n>1.1f) {return NAN;}
+    return 1.f-2.f*(q[1]*q[1]+q[2]*q[2])/n;
+}
+inline bool rc_conflict(const int8_t *functions,size_t count,int channel) {
+    if(channel<1 || channel>18 || !functions) {return true;}
+    for(size_t i=0;i<count;++i) {
+        // Only generic AUX1..AUX6 sharing is permitted. All other mapped functions conflict.
+        if(i>=8 && i<=13) {continue;}
+        if(functions[i]==channel-1) {return true;}
+    }
+    return false;
+}
+inline bool quad_corner(unsigned c,float x,float y,float ax,float ay,float az) {
+    if(!std::isfinite(x)||!std::isfinite(y)||!std::isfinite(ax)||!std::isfinite(ay)||!std::isfinite(az)) {return false;}
+    const float norm=std::sqrt(ax*ax+ay*ay+az*az);
+    if(!std::isfinite(norm) || norm<0.000001f) {return false;}
+    ax/=norm;ay/=norm;az/=norm;
+    const bool front=c<2, right=c==1||c==3;
+    return (front?x>0.0001f:x< -0.0001f) && (right?y>0.0001f:y< -0.0001f)
+        && std::fabs(ax)<0.01f && std::fabs(ay)<0.01f && az< -0.99f;
+}
+} // namespace dragonfly_trtl
diff --git a/src/drivers/dshot/DragonflyTurtleMapping.hpp b/src/drivers/dshot/DragonflyTurtleMapping.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..9b3926ea45dd5d270d0228a7339b2baff0ab753c
--- /dev/null
+++ b/src/drivers/dshot/DragonflyTurtleMapping.hpp
@@ -0,0 +1,98 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Configurable Quad-X corner -> PX4 logical motor -> local DShot output mapping.
+// No actuator calls. Output slots are zero based internally, motor IDs are 1 based.
+#pragma once
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+
+namespace dragonfly_mapping {
+enum Corner : uint8_t { FL = 0, FR = 1, RL = 2, RR = 3 };
+enum class Error : uint8_t {
+    NONE, UNCONFIGURED, MOTOR_ID, DUPLICATE_MOTOR, OUTPUT_COUNT,
+    MISSING_OUTPUT, DUPLICATE_OUTPUT, EXTRA_FUNCTION, INACTIVE_OUTPUT
+};
+inline const char *error_name(Error e) {
+    switch (e) {
+    case Error::NONE: return "OK";
+    case Error::UNCONFIGURED: return "UNCONFIGURED";
+    case Error::MOTOR_ID: return "MOTOR_ID";
+    case Error::DUPLICATE_MOTOR: return "DUPLICATE_MOTOR";
+    case Error::OUTPUT_COUNT: return "OUTPUT_COUNT";
+    case Error::MISSING_OUTPUT: return "MISSING_OUTPUT";
+    case Error::DUPLICATE_OUTPUT: return "DUPLICATE_OUTPUT";
+    case Error::EXTRA_FUNCTION: return "EXTRA_FUNCTION";
+    case Error::INACTIVE_OUTPUT: return "INACTIVE_OUTPUT";
+    }
+    return "UNKNOWN";
+}
+struct Config { int32_t motor[4]{0, 0, 0, 0}; };
+struct Resolved {
+    uint32_t corner[4]{0, 0, 0, 0};
+    uint32_t all{0};
+    Error error{Error::UNCONFIGURED};
+    bool valid() const { return error == Error::NONE; }
+};
+inline Error validate(const Config &cfg) {
+    for (unsigned i = 0; i < 4; ++i) {
+        if (cfg.motor[i] == 0) { return Error::UNCONFIGURED; }
+        // This release is deliberately restricted to one four-motor vehicle.
+        if (cfg.motor[i] < 1 || cfg.motor[i] > 4) { return Error::MOTOR_ID; }
+        for (unsigned j = 0; j < i; ++j) {
+            if (cfg.motor[i] == cfg.motor[j]) { return Error::DUPLICATE_MOTOR; }
+        }
+    }
+    return Error::NONE;
+}
+inline Resolved resolve(const Config &cfg, const int32_t *functions,
+                        size_t count, uint32_t active_outputs) {
+    Resolved r;
+    r.error = validate(cfg);
+    if (!r.valid()) { return r; }
+    if (!functions || count == 0 || count > 32) { r.error = Error::OUTPUT_COUNT; return r; }
+    // Only disabled outputs or precisely Motor 1..4 may share this DShot instance.
+    for (size_t slot = 0; slot < count; ++slot) {
+        const int32_t fn = functions[slot];
+        if (fn == 0) { continue; }
+        unsigned corner = 4;
+        for (unsigned c = 0; c < 4; ++c) {
+            if (fn == 100 + cfg.motor[c]) { corner = c; break; }
+        }
+        if (corner == 4) { r.error = Error::EXTRA_FUNCTION; return r; }
+        const uint32_t bit = uint32_t{1} << slot;
+        if (!(active_outputs & bit)) { r.error = Error::INACTIVE_OUTPUT; return r; }
+        if (r.corner[corner]) { r.error = Error::DUPLICATE_OUTPUT; return r; }
+        r.corner[corner] = bit;
+        r.all |= bit;
+    }
+    for (unsigned c = 0; c < 4; ++c) {
+        if (!r.corner[c]) { r.error = Error::MISSING_OUTPUT; return r; }
+    }
+    r.error = Error::NONE;
+    return r;
+}
+inline bool same(const Resolved &a, const Resolved &b) {
+    if (!a.valid() || !b.valid() || a.all != b.all) { return false; }
+    for (unsigned i = 0; i < 4; ++i) { if (a.corner[i] != b.corner[i]) { return false; } }
+    return true;
+}
+inline uint32_t select(const Resolved &map, float roll, float pitch, float deadband = 0.35f) {
+    if (!map.valid() || !std::isfinite(roll) || !std::isfinite(pitch)
+        || std::fabs(roll) > 1.05f || std::fabs(pitch) > 1.05f) { return 0; }
+    if (!std::isfinite(deadband) || deadband < 0.05f || deadband > 0.6f) { return 0; }
+    uint32_t mask = map.all;
+    bool selected = false;
+    if (roll > deadband) { mask &= map.corner[FR] | map.corner[RR]; selected = true; }
+    else if (roll < -deadband) { mask &= map.corner[FL] | map.corner[RL]; selected = true; }
+    // Preserve Dragonfly's tested convention: +pitch selects front motors.
+    if (pitch > deadband) { mask &= map.corner[FL] | map.corner[FR]; selected = true; }
+    else if (pitch < -deadband) { mask &= map.corner[RL] | map.corner[RR]; selected = true; }
+    return selected ? mask : 0;
+}
+inline unsigned output_number(uint32_t single_bit) {
+    if (!single_bit || (single_bit & (single_bit - 1))) { return 0; }
+    unsigned n = 1;
+    while ((single_bit >>= 1) != 0) { ++n; }
+    return n;
+}
+} // namespace dragonfly_mapping
diff --git a/src/drivers/dshot/DragonflyTurtleMotor.hpp b/src/drivers/dshot/DragonflyTurtleMotor.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..907c7a9c9327ae23d5d70dadb1662df5ac8a62c1
--- /dev/null
+++ b/src/drivers/dshot/DragonflyTurtleMotor.hpp
@@ -0,0 +1,230 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Dragonfly 2B7: repeatable AM32 recovery with latched PX4 parameter limits.
+// Bench candidate: no ESC acknowledgement is available for direction restoration.
+#pragma once
+#include <cstdint>
+
+#define DRAGONFLY_TURTLE_MOTOR_OUTPUT_ENABLED 1
+
+namespace dragonfly_motor
+{
+// Keep existing enum indices 0..5 stable for cumulative Stage 2B1 diagnostics.
+enum class Phase : uint8_t {
+    IDLE = 0, REVERSE = 1, SETTLE = 2, DRIVE = 3, RESTORE = 4, LOCKED = 5,
+    PRESTOP = 6, POSTSTOP = 7, COOLDOWN = 8, WAIT_RELEASE = 9
+};
+enum class Action : uint8_t { NORMAL, STOP, REVERSE_COMMAND, RESTORE_COMMAND, THROTTLE };
+
+inline const char *phase_name(Phase p)
+{
+    switch (p) {
+    case Phase::IDLE: return "IDLE";
+    case Phase::PRESTOP: return "PRESTOP";
+    case Phase::REVERSE: return "REVERSE";
+    case Phase::SETTLE: return "SETTLE";
+    case Phase::DRIVE: return "DRIVE";
+    case Phase::POSTSTOP: return "POSTSTOP";
+    case Phase::RESTORE: return "RESTORE";
+    case Phase::COOLDOWN: return "COOLDOWN";
+    case Phase::WAIT_RELEASE: return "WAIT_RELEASE";
+    case Phase::LOCKED: return "LOCKED";
+    }
+    return "UNKNOWN";
+}
+inline const char *action_name(Action a)
+{
+    switch (a) {
+    case Action::NORMAL: return "NORMAL";
+    case Action::STOP: return "STOP";
+    case Action::REVERSE_COMMAND: return "REVERSE_21";
+    case Action::RESTORE_COMMAND: return "RESTORE_20";
+    case Action::THROTTLE: return "THROTTLE";
+    }
+    return "UNKNOWN";
+}
+struct Frame {
+    Action action{Action::NORMAL};
+    uint32_t output_mask{0};
+    uint16_t level{0};
+};
+
+class Sequencer
+{
+public:
+    static constexpr int command_frames = 24;       // ESC requires >=6 valid matching commands
+    static constexpr uint64_t prestop_us = 150000;   // settled before reverse command
+    static constexpr uint64_t settle_us = 150000;    // stopped before power
+    static constexpr uint64_t drive_cap_us = 1000000; // hard max 1 s motor driving
+    static constexpr uint64_t poststop_us = 600000;  // let coasting motors stop before restore
+    static constexpr uint64_t cooldown_us = 250000;
+    static constexpr uint64_t release_hold_us = 250000;
+    static constexpr uint64_t ramp_us = 250000;
+    // PX4 DShot driver uses 1..1999 command range, not physical torque percentage.
+    static constexpr uint16_t start_level = 850;
+    static constexpr uint16_t max_level = 1500;       // bounded stronger default
+
+    // Hard bounds independent of QGroundControl metadata. Configuration is accepted
+    // only while IDLE, and is therefore latched for each recovery attempt.
+    static constexpr uint16_t hard_min_start = 1;
+    static constexpr uint16_t hard_max_start = 1999;
+    static constexpr uint16_t hard_min_max = 1;
+    static constexpr uint16_t hard_max_max = 1999;
+    static constexpr uint32_t hard_min_ramp_ms = 0;
+    static constexpr uint32_t hard_max_ramp_ms = 1500;
+    static constexpr uint32_t hard_min_drive_ms = 100;
+    static constexpr uint32_t hard_max_drive_ms = 1500;
+
+    // Map remains latched through reverse, drive, restore and switch release.
+    bool configure_outputs(uint32_t mask)
+    {
+        if (phase != Phase::IDLE || flight_inhibited) { return false; }
+        unsigned bits = 0;
+        for (uint32_t n = mask; n; n &= n - 1) { ++bits; }
+        if (bits != 4) { return false; }
+        _mapped_outputs = mask;
+        return true;
+    }
+    uint32_t configured_outputs() const { return _mapped_outputs; }
+
+    bool configure(int32_t requested_start, int32_t requested_max,
+                   int32_t requested_ramp_ms, int32_t requested_drive_ms)
+    {
+        if (phase != Phase::IDLE || flight_inhibited) { return false; }
+        _max_level = limit(requested_max, hard_min_max, hard_max_max);
+        _start_level = limit(requested_start, hard_min_start, hard_max_start);
+        if (_start_level > _max_level) { _start_level = _max_level; }
+        _ramp_us = static_cast<uint64_t>(limit(requested_ramp_ms, hard_min_ramp_ms, hard_max_ramp_ms)) * 1000;
+        _drive_cap_us = static_cast<uint64_t>(limit(requested_drive_ms, hard_min_drive_ms, hard_max_drive_ms)) * 1000;
+        return true;
+    }
+
+    uint16_t configured_start() const { return _start_level; }
+    uint16_t configured_max() const { return _max_level; }
+    uint32_t configured_ramp_ms() const { return static_cast<uint32_t>(_ramp_us / 1000); }
+    uint32_t configured_drive_ms() const { return static_cast<uint32_t>(_drive_cap_us / 1000); }
+
+    Phase phase{Phase::IDLE};
+    bool flight_inhibited{false};
+    uint32_t attempts{0};
+    uint32_t restorations_sent{0}; // count sequences SENT, not ESC acknowledgements
+
+    Frame step(uint64_t now, bool eligible, uint32_t selected_mask,
+               bool disarmed, bool commands_idle, bool release_ok)
+    {
+        selected_mask &= _mapped_outputs;
+        const bool permit = eligible && disarmed && commands_idle && _mapped_outputs != 0;
+
+        if (phase == Phase::IDLE) {
+            if (!permit) { return {}; }
+            flight_inhibited = true;
+            ++attempts;
+            phase = Phase::PRESTOP;
+            _since = now;
+            _count = 0;
+        }
+
+        // Immediate output STOP on cancellation. Restoration follows after motors coast down.
+        if (!permit && (phase == Phase::PRESTOP || phase == Phase::REVERSE
+                        || phase == Phase::SETTLE || phase == Phase::DRIVE)) {
+            phase = Phase::POSTSTOP;
+            _since = now;
+            _count = 0;
+        }
+
+        switch (phase) {
+        case Phase::PRESTOP:
+            if (!elapsed(now, prestop_us)) { return stop(); }
+            phase = Phase::REVERSE;
+            _count = 0;
+            // fall through, first reverse frame on this call
+            [[fallthrough]];
+        case Phase::REVERSE: {
+            Frame f{Action::REVERSE_COMMAND, _mapped_outputs, 0};
+            if (++_count >= command_frames) {
+                phase = Phase::SETTLE;
+                _since = now;
+            }
+            return f;
+        }
+        case Phase::SETTLE:
+            if (!elapsed(now, settle_us)) { return stop(); }
+            phase = Phase::DRIVE;
+            _since = now;
+            // fall through into bounded motor-driving period
+            [[fallthrough]];
+        case Phase::DRIVE:
+            if (!elapsed_valid(now) || elapsed(now, _drive_cap_us)) {
+                phase = Phase::POSTSTOP;
+                _since = now;
+                return stop();
+            }
+            return selected_mask ? Frame{Action::THROTTLE, selected_mask, ramp_level(now - _since)}
+                   : stop();
+        case Phase::POSTSTOP:
+            if (!elapsed(now, poststop_us)) { return stop(); }
+            phase = Phase::RESTORE;
+            _count = 0;
+            // fall through to issue the first restore command
+            [[fallthrough]];
+        case Phase::RESTORE: {
+            Frame f{Action::RESTORE_COMMAND, _mapped_outputs, 0};
+            if (++_count >= command_frames) {
+                ++restorations_sent;
+                phase = Phase::COOLDOWN;
+                _since = now;
+            }
+            return f;
+        }
+        case Phase::COOLDOWN:
+            if (elapsed(now, cooldown_us)) {
+                phase = Phase::WAIT_RELEASE;
+                _release_since = 0;
+            }
+            return stop();
+        case Phase::WAIT_RELEASE:
+            if (!release_ok || !disarmed || !commands_idle) {
+                _release_since = 0;
+                return stop();
+            }
+            if (_release_since == 0) { _release_since = now; return stop(); }
+            if (now < _release_since) { _release_since = 0; return stop(); }
+            if (now - _release_since < release_hold_us) { return stop(); }
+            // The restore commands have been SENT, not independently acknowledged by ESCs.
+            // Re-enable normal PX4 output only with RC-valid switch OFF / low throttle / disarmed.
+            flight_inhibited = false;
+            phase = Phase::IDLE;
+            _release_since = 0;
+            return {};
+        case Phase::LOCKED:
+            return stop();
+        case Phase::IDLE:
+            return {};
+        }
+        return stop();
+    }
+
+private:
+    uint32_t _mapped_outputs{0};
+    uint16_t _start_level{start_level};
+    uint16_t _max_level{max_level};
+    uint64_t _ramp_us{ramp_us};
+    uint64_t _drive_cap_us{drive_cap_us};
+    uint32_t _count{0};
+    uint64_t _since{0};
+    uint64_t _release_since{0};
+
+    static uint16_t limit(int32_t v, int32_t lo, int32_t hi)
+    {
+        return static_cast<uint16_t>(v < lo ? lo : (v > hi ? hi : v));
+    }
+    static Frame stop() { return {Action::STOP, 0, 0}; }
+    bool elapsed_valid(uint64_t now) const { return now >= _since; }
+    bool elapsed(uint64_t now, uint64_t us) const { return now >= _since && now - _since >= us; }
+    uint16_t ramp_level(uint64_t elapsed_us) const
+    {
+        if (elapsed_us >= _ramp_us) { return _max_level; }
+        return static_cast<uint16_t>(_start_level +
+            (static_cast<uint64_t>(_max_level - _start_level) * elapsed_us) / _ramp_us);
+    }
+};
+} // namespace dragonfly_motor
