@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// PX4 FPV Extensions: RC channel selection for Dragonfly recovery.
+// Experimental extension; do not use without hardware-specific review.
+#pragma once
+
+#include <cmath>
+#include <cstdint>
+#include <math.h> // NAN without the unavailable C++ <limits> header
+
+namespace dragonfly_turtle_rc
+{
+static constexpr int32_t min_channel = 1; // actual function assignments are checked separately
+static constexpr int32_t max_channel = 18;
+static constexpr int32_t default_channel = 9;
+static constexpr uint64_t max_age_us = 300000;
+
+inline bool healthy(uint64_t now, uint64_t timestamp, uint64_t last_valid,
+                    bool signal_lost)
+{
+    // Some PX4 RC publishers leave timestamp_last_valid at zero. The primary
+    // timestamp and signal_lost still have to pass; zero is not a freshness
+    // bypass. When a nonzero last-valid timestamp is supplied, check it too.
+    // The caller separately requires fresh, valid RC-origin manual input.
+    if (signal_lost || timestamp == 0 || now < timestamp
+        || now - timestamp >= max_age_us) {
+        return false;
+    }
+    return last_valid == 0
+           || (now >= last_valid && now - last_valid < max_age_us);
+}
+
+inline float select(const float *values, uint8_t count, int32_t channel)
+{
+    if (!values || channel < min_channel || channel > max_channel || count < channel) {
+        return NAN;
+    }
+    const float value = values[channel - 1];
+    return std::isfinite(value) ? value : NAN;
+}
+
+inline bool on(float value) { return std::isfinite(value) && value > 0.7f; }
+inline bool off(float value) { return std::isfinite(value) && value < 0.3f; }
+} // namespace dragonfly_turtle_rc
