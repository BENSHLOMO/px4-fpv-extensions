@@ -0,0 +1,63 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#pragma once
+#include <cstdint>
+namespace dragonfly_turtle {
+enum class State : uint8_t { IDLE, HOLD, ACTIVE, LOCKOUT };
+
+inline const char *state_name(State s)
+{
+    switch (s) {
+    case State::IDLE: return "IDLE";
+    case State::HOLD: return "HOLD";
+    case State::ACTIVE: return "ACTIVE";
+    case State::LOCKOUT: return "LOCKOUT";
+    }
+    return "UNKNOWN";
+}
+
+struct RecoveryTimer
+{
+    static constexpr uint64_t hold_us = 400000;       // 0.4 s continuous eligibility
+    static constexpr uint64_t max_active_us = 2000000; // 2.0 s simulated active window
+
+    State state{State::IDLE};
+    uint64_t since{0};
+
+    // rc_ok must be independent of the derived switch_on value.
+    // After loss of eligibility during HOLD/ACTIVE, require an observed RC-valid switch OFF.
+    void update(uint64_t now, bool rc_ok, bool switch_on, bool candidate)
+    {
+        if (rc_ok && !switch_on) {
+            state = State::IDLE;
+            since = 0;
+            return;
+        }
+        if (state == State::LOCKOUT) { return; }
+
+        if (!rc_ok || !candidate) {
+            if (state == State::HOLD || state == State::ACTIVE) {
+                state = State::LOCKOUT;
+            } else {
+                state = State::IDLE;
+            }
+            since = 0;
+            return;
+        }
+
+        if (state == State::IDLE) {
+            state = State::HOLD;
+            since = now;
+        } else if (state == State::HOLD) {
+            if (now < since) { state = State::LOCKOUT; since = 0; }
+            else if (now - since >= hold_us) { state = State::ACTIVE; since = now; }
+        } else if (state == State::ACTIVE) {
+            if (now < since || now - since >= max_active_us) {
+                state = State::LOCKOUT;
+                since = 0;
+            }
+        }
+    }
+
+    bool simulated_active() const { return state == State::ACTIVE; }
+};
+} // namespace dragonfly_turtle
